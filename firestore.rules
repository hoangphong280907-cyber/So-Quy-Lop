rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /so_quy_rooms/{roomId} {
      allow read: if true;
      // Thủ quỹ (đã đăng nhập Firebase Auth đúng UID) có toàn quyền ghi
      allow write: if request.auth != null
                   && request.auth.uid == "DAN_UID_TAI_KHOAN_THU_QUY_VAO_DAY";
      // Khách mở link công khai chỉ được phép cập nhật trường guestReports (tự báo Đã CK),
      // tuyệt đối bị chặn sửa số dư, giao dịch, danh sách thành viên hoặc PIN
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestReports']);
    }
  }
}
